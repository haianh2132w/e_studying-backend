generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum SettingType { ROLE CATEGORY }
enum ContentStatus { DRAFT PUBLISHED }
enum LessonType { VIDEO DOCUMENT LINK }
enum EnrollmentStatus { PENDING ACTIVE CANCELLED }
enum ClassStudentStatus { ACTIVE INACTIVE }
enum PaymentMethod { FREE VNPAY }
enum PaymentStatus { PENDING SUCCESS FAILED }
enum TokenType { VERIFY_EMAIL RESET_PASSWORD }

model Setting {
  id          Int         @id @default(autoincrement())
  type        SettingType
  name        String      @db.VarChar(100)
  description String?     @db.Text
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  users       User[]
  courses     Course[]
  classes     Class[]
  posts       Post[]
  @@unique([type, name])
}

model User {
  id            Int      @id @default(autoincrement())
  email         String   @unique @db.VarChar(255)
  username      String   @unique @db.VarChar(50)
  passwordHash  String   @db.VarChar(255)
  fullName      String   @db.VarChar(100)
  avatarUrl     String?  @db.VarChar(500)
  bio           String?  @db.Text
  roleId        Int
  role          Setting  @relation(fields: [roleId], references: [id])
  isActive      Boolean  @default(true)
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  tokens        AuthToken[]
  refreshTokens RefreshToken[]
  courses       Course[]
  classes       Class[]
  enrollments   Enrollment[]
  classStudents ClassStudent[]
  progress      LessonProgress[]
  attempts      QuizAttempt[]
  posts         Post[]
  auditLogs     AuditLog[]
}

model AuthToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      TokenType
  codeHash  String    @db.VarChar(64)
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  @@index([userId, type])
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @db.VarChar(64)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
}

model Course {
  id            Int        @id @default(autoincrement())
  title         String     @db.VarChar(200)
  description   String?    @db.Text
  objectives    String?    @db.Text
  thumbnailUrl  String?    @db.VarChar(500)
  durationHours Int        @default(0)
  price         Decimal    @default(0) @db.Decimal(12, 0)
  salePrice     Decimal?   @db.Decimal(12, 0)
  isFeatured    Boolean    @default(false)
  isActive      Boolean    @default(true)
  categoryId    Int
  category      Setting    @relation(fields: [categoryId], references: [id])
  instructorId  Int
  instructor    User       @relation(fields: [instructorId], references: [id])
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  chapters      Chapter[]
  enrollments   Enrollment[]
  classCourses  ClassCourse[]
  @@index([isActive, categoryId])
  @@index([instructorId])
  @@index([title])
}

model Chapter {
  id          Int           @id @default(autoincrement())
  courseId    Int
  course      Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String        @db.VarChar(200)
  description String?       @db.Text
  position    Int           @default(0)
  status      ContentStatus @default(DRAFT)
  lessons     Lesson[]
  quizzes     Quiz[]
  @@index([courseId, position])
}

model Lesson {
  id          Int              @id @default(autoincrement())
  chapterId   Int
  chapter     Chapter          @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  title       String           @db.VarChar(200)
  type        LessonType       @default(VIDEO)
  content     String?          @db.LongText
  resourceUrl String?          @db.VarChar(500)
  durationMin Int              @default(0)
  position    Int              @default(0)
  isPreview   Boolean          @default(false)
  status      ContentStatus    @default(DRAFT)
  progress    LessonProgress[]
  @@index([chapterId, position])
}

model Quiz {
  id           Int           @id @default(autoincrement())
  chapterId    Int
  chapter      Chapter       @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  title        String        @db.VarChar(200)
  instructions String?       @db.Text
  status       ContentStatus @default(DRAFT)
  questions    Question[]
  attempts     QuizAttempt[]
}

model Question {
  id       Int      @id @default(autoincrement())
  quizId   Int
  quiz     Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  content  String   @db.Text
  position Int      @default(0)
  answers  Answer[]
}

model Answer {
  id         Int      @id @default(autoincrement())
  questionId Int
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  content    String   @db.Text
  isCorrect  Boolean  @default(false)
}

model QuizAttempt {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  quizId      Int
  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  score       Int
  total       Int
  submittedAt DateTime @default(now())
}

model LessonProgress {
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId    Int
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completedAt DateTime @default(now())
  @@id([userId, lessonId])
}

model Class {
  id           Int          @id @default(autoincrement())
  title        String       @db.VarChar(200)
  description  String?      @db.Text
  objectives   String?      @db.Text
  assessment   String?      @db.Text
  schedule     String?      @db.VarChar(500)
  totalHours   Int          @default(0)
  thumbnailUrl String?      @db.VarChar(500)
  price        Decimal      @default(0) @db.Decimal(12, 0)
  salePrice    Decimal?     @db.Decimal(12, 0)
  startDate    DateTime
  endDate      DateTime
  isActive     Boolean      @default(true)
  categoryId   Int
  category     Setting      @relation(fields: [categoryId], references: [id])
  instructorId Int
  instructor   User         @relation(fields: [instructorId], references: [id])
  syllabus     ClassSession[]
  courses      ClassCourse[]
  students     ClassStudent[]
  enrollments  Enrollment[]
  @@index([isActive, categoryId])
}

model ClassSession {
  id        Int    @id @default(autoincrement())
  classId   Int
  class     Class  @relation(fields: [classId], references: [id], onDelete: Cascade)
  sessionNo Int
  objective String @db.Text
  @@unique([classId, sessionNo])
}

model ClassCourse {
  classId  Int
  class    Class  @relation(fields: [classId], references: [id], onDelete: Cascade)
  courseId Int
  course   Course @relation(fields: [courseId], references: [id])
  @@id([classId, courseId])
}

model ClassStudent {
  classId Int
  class   Class              @relation(fields: [classId], references: [id], onDelete: Cascade)
  userId  Int
  user    User               @relation(fields: [userId], references: [id])
  status  ClassStudentStatus @default(ACTIVE)
  @@id([classId, userId])
}

model Enrollment {
  id         Int              @id @default(autoincrement())
  userId     Int
  user       User             @relation(fields: [userId], references: [id])
  courseId   Int?
  course     Course?          @relation(fields: [courseId], references: [id])
  classId    Int?
  class      Class?           @relation(fields: [classId], references: [id])
  pricePaid  Decimal          @default(0) @db.Decimal(12, 0)
  status     EnrollmentStatus @default(PENDING)
  enrolledAt DateTime         @default(now())
  payment    Payment?
  @@unique([userId, courseId])
  @@unique([userId, classId])
}

model Payment {
  id            Int           @id @default(autoincrement())
  enrollmentId  Int           @unique
  enrollment    Enrollment    @relation(fields: [enrollmentId], references: [id])
  method        PaymentMethod
  amount        Decimal       @db.Decimal(12, 0)
  status        PaymentStatus @default(PENDING)
  txnRef        String        @unique @db.VarChar(64)
  gatewayTxnNo  String?       @db.VarChar(64)
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
}

model Post {
  id          Int           @id @default(autoincrement())
  authorId    Int
  author      User          @relation(fields: [authorId], references: [id])
  categoryId  Int?
  category    Setting?      @relation(fields: [categoryId], references: [id])
  title       String        @db.VarChar(200)
  content     String        @db.LongText
  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  @@index([status, publishedAt])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id])
  action    String   @db.VarChar(100)
  entity    String   @db.VarChar(100)
  entityId  String?  @db.VarChar(50)
  ip        String?  @db.VarChar(64)
  metadata  Json?
  createdAt DateTime @default(now())
  @@index([userId, createdAt])
}